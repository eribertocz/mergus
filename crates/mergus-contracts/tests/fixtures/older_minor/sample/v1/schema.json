{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sample",
  "description": "The `sample` contract as an older minor version of major 1 wrote it: without `location.depth`, `tags` and `owner`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "contract_version",
    "name",
    "kind",
    "location"
  ],
  "properties": {
    "contract": {
      "description": "The name of the contract.",
      "const": "sample"
    },
    "contract_version": {
      "description": "The version of the contract.",
      "const": 1
    },
    "name": {
      "description": "The name of the sample.",
      "type": "string"
    },
    "kind": {
      "description": "What the sample is.",
      "enum": [
        "table",
        "view"
      ]
    },
    "location": {
      "description": "Where the sample lives.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "description": "The path of the sample.",
          "type": "string"
        }
      }
    },
    "ratio": {
      "description": "A share between zero and one.",
      "type": "number"
    },
    "public": {
      "description": "Whether everyone may read the sample.",
      "type": "boolean"
    }
  }
}
