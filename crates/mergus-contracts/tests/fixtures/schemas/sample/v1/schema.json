{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sample",
  "description": "A contract that exercises every keyword the generator and the validator support.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "contract_version", "name", "kind", "location"],
  "properties": {
    "contract": {
      "description": "The name of the contract.",
      "const": "sample"
    },
    "contract_version": {
      "description": "The version of the contract.",
      "const": 1
    },
    "name": {
      "description": "The name of the sample.",
      "type": "string"
    },
    "kind": {
      "description": "What the sample is.",
      "enum": ["table", "view"]
    },
    "location": {
      "description": "Where the sample lives.",
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "description": "The path of the sample.",
          "type": "string"
        },
        "depth": {
          "description": "How deep the path is.",
          "type": "integer"
        }
      }
    },
    "ratio": {
      "description": "A share between zero and one.",
      "type": "number"
    },
    "public": {
      "description": "Whether everyone may read the sample.",
      "type": "boolean"
    },
    "tags": {
      "description": "Free labels.",
      "type": "array",
      "items": {
        "description": "One label.",
        "type": "string"
      }
    },
    "owner": {
      "description": "Who owns the sample.",
      "$ref": "#/$defs/owner"
    }
  },
  "$defs": {
    "owner": {
      "description": "A team that owns something.",
      "type": "object",
      "additionalProperties": false,
      "required": ["team"],
      "properties": {
        "team": {
          "description": "The name of the team.",
          "type": "string"
        }
      }
    }
  }
}
