{
  "/repos/owner/repo": {
    "default_branch": "main",
    "full_name": "owner/repo"
  },
  "/repos/owner/repo/rulesets": [
    {
      "id": 1,
      "name": "main",
      "target": "branch"
    },
    {
      "id": 3,
      "name": "develop",
      "target": "branch"
    },
    {
      "id": 4,
      "name": "partial",
      "target": "branch"
    },
    {
      "id": 2,
      "name": "release-tags",
      "target": "tag"
    }
  ],
  "/repos/owner/repo/rulesets/1": {
    "bypass_actors": [],
    "conditions": {
      "ref_name": {
        "exclude": [],
        "include": [
          "~DEFAULT_BRANCH"
        ]
      }
    },
    "enforcement": "disabled",
    "id": 1,
    "name": "main",
    "rules": [
      {
        "type": "deletion"
      },
      {
        "type": "non_fast_forward"
      },
      {
        "type": "pull_request"
      }
    ],
    "target": "branch"
  },
  "/repos/owner/repo/rulesets/2": {
    "bypass_actors": [
      {
        "actor_id": 5,
        "actor_type": "RepositoryRole",
        "bypass_mode": "always"
      }
    ],
    "conditions": {
      "ref_name": {
        "exclude": [],
        "include": [
          "refs/tags/v*"
        ]
      }
    },
    "enforcement": "active",
    "id": 2,
    "name": "release-tags",
    "rules": [
      {
        "type": "creation"
      },
      {
        "type": "update"
      },
      {
        "type": "deletion"
      },
      {
        "type": "non_fast_forward"
      }
    ],
    "target": "tag"
  },
  "/repos/owner/repo/rulesets/3": {
    "bypass_actors": [],
    "conditions": {
      "ref_name": {
        "exclude": [],
        "include": [
          "refs/heads/develop"
        ]
      }
    },
    "enforcement": "active",
    "id": 3,
    "name": "develop",
    "rules": [
      {
        "type": "deletion"
      },
      {
        "type": "non_fast_forward"
      },
      {
        "type": "pull_request"
      }
    ],
    "target": "branch"
  },
  "/repos/owner/repo/rulesets/4": {
    "bypass_actors": [],
    "conditions": {
      "ref_name": {
        "exclude": [],
        "include": [
          "~DEFAULT_BRANCH"
        ]
      }
    },
    "enforcement": "active",
    "id": 4,
    "name": "partial",
    "rules": [
      {
        "type": "non_fast_forward"
      },
      {
        "type": "pull_request"
      }
    ],
    "target": "branch"
  }
}
