{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh pr review --approve *)",
      "Bash(gh release *)",
      "Bash(gh repo *)",
      "Bash(gh ruleset *)",
      "Bash(gh label *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh workflow *)",
      "Bash(git tag *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main *)",
      "Bash(git push origin HEAD:main *)",
      "Bash(git push * --tags *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main*)",
      "Bash(git push *:refs/heads/main*)",
      "Bash(git push * +*)",
      "Bash(git push --mirror *)",
      "Bash(git push --delete *)",
      "Bash(git push * --delete *)",
      "Bash(git push origin main)",
      "Bash(gh pr merge)",
      "Bash(gh pr review --approve)",
      "Bash(gh api *merge*)",
      "Bash(gh api *APPROVE*)",
      "Bash(gh api *ruleset*)",
      "Bash(gh api *protection*)",
      "Bash(gh api *releases*)",
      "Bash(gh api *git/refs*)",
      "Bash(gh api *git/tags*)",
      "Bash(gh api *collaborators*)",
      "Bash(gh api *hooks*)",
      "Bash(gh api *secrets*)",
      "Bash(gh api *variables*)",
      "Bash(gh api *DELETE*)",
      "Bash(gh api *PUT*)",
      "Bash(gh api graphql*)",
      "mcp__*merge*",
      "mcp__*review*",
      "mcp__*release*",
      "mcp__*ruleset*",
      "mcp__*protection*",
      "mcp__*delete*",
      "mcp__*create_tag*",
      "mcp__*create_ref*",
      "mcp__*update_ref*",
      "mcp__*secret*",
      "mcp__*settings*",
      "mcp__*collaborator*",
      "mcp__*webhook*"
    ]
  }
}